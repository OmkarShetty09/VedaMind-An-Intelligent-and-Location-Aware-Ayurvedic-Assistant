# ---- Django / backend ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# CORS (dev: vite origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Database ----
POSTGRES_DB=vedamind
POSTGRES_USER=vedamind
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- JWT ----
JWT_SIGNING_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---- RAG service ----
RAG_SERVICE_URL=http://rag:8001
RAG_ADMIN_TOKEN=change-me

# ---- LLM providers ----
# Primary: Gemini -> live fallback: Groq -> local fallback: Ollama
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
LLM_PRIMARY_MODEL=gemini-2.5-pro
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_LOCAL_FALLBACK_MODEL=llama3.2
LLM_CHEAP_MODEL=gemini-2.5-flash
OPENAI_API_KEY=sk-...

# ---- RAG pipeline ----
VECTOR_STORE=pgvector
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024
RERANKER_MODEL=bge-reranker-v2-m3
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=50
CONTEXT_MAX_TOKENS=6000
QUERY_CACHE_TTL_HOURS=24

# ---- OpenWeather ----
OPENWEATHER_API_KEY=...
OPENWEATHER_CACHE_TTL_MINUTES=30

# ---- Seed data ----
DEMO_EMAIL=admin@vedamind.local
DEMO_PASSWORD=change-me