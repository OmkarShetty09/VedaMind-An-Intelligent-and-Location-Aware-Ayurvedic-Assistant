# VedaMind configuration. Copy to `.env` (same folder) and fill in the API keys.
# Read by the backend (Django), the RAG service and docker compose.
# Hostnames below are for running WITHOUT Docker; docker-compose.yml overrides them
# for the containers (postgres / redis / rag / backend), so the same file works for both.
# Use 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 first and adds ~2s per call.

# Secrets (DJANGO_SECRET_KEY, JWT_SIGNING_KEY, RAG_ADMIN_TOKEN, passwords) have NO defaults in code.
# scripts\windows\setup.ps1 replaces the internal secrets marked "change-me" with random values when it creates .env.
# The admin and demo passwords (bottom of this file) are fixed so you can log in; change them there if you like.
# Production settings refuse to start with placeholder or short (<32 chars) secrets.

# ---- Django / backend ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# CORS (dev: vite origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL 16 with the pgvector extension) ----
POSTGRES_DB=vedamind
POSTGRES_USER=vedamind
POSTGRES_PASSWORD=vedamind
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# The RAG service connects with one URL; keep it in sync with the values above.
DATABASE_URL=postgresql://vedamind:vedamind@127.0.0.1:5432/vedamind

# ---- Redis / Celery ----
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---- JWT ----
JWT_SIGNING_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---- Service-to-service ----
RAG_SERVICE_URL=http://127.0.0.1:8001
BACKEND_GUARDRAIL_URL=http://127.0.0.1:8000/api/v1/guardrails/check
# Shared secret between backend and RAG service (any random string, same for both).
RAG_ADMIN_TOKEN=change-me

# ---- LLM providers ----
# Answers: Gemini (primary) -> Groq (live fallback) -> Ollama (local fallback).
# GEMINI_API_KEY is REQUIRED: it also creates the embeddings for the knowledge base.
#   Free key: https://aistudio.google.com/apikey
# GROQ_API_KEY is optional but recommended (free: https://console.groq.com/keys) - used when Gemini is busy.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLM_PRIMARY_MODEL=gemini-3.6-flash
LLM_CHEAP_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_LOCAL_FALLBACK_MODEL=llama3.2
# Gemini 3 "thinking" before answering: minimal = fast first token. Leave empty for the model default.
LLM_THINKING_LEVEL=minimal

# ---- RAG pipeline ----
VECTOR_STORE=pgvector
# Do not change EMBEDDING_DIM after ingesting (the pgvector column is created with this size).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-3-large
RERANKER_MODEL=bge-reranker-v2-m3
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=50
CONTEXT_MAX_TOKENS=6000
QUERY_CACHE_TTL_HOURS=24

# ---- Weather / geocoding (Open-Meteo + OpenStreetMap Nominatim, no API keys) ----
WEATHER_CACHE_TTL_MINUTES=30
WEATHER_REFRESH_SECONDS=3600
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=VedaMind/1.0 (student project)
EXTERNAL_HTTP_TIMEOUT_SECONDS=5

# ---- Dinacharya ----
# Dosha used for the routine before the user has taken the quiz.
DINACHARYA_DEFAULT_DOSHA=vata

# ---- Guardrail audit ----
# Comma-separated emails for the daily guardrail digest (Celery beat); empty = no email.
GUARDRAIL_DIGEST_RECIPIENTS=
GUARDRAIL_DIGEST_SECONDS=86400
GUARDRAIL_RULE_STEWARD=unassigned

# ---- Accounts (created by start.ps1 / manage.py create_superuser and seed_demo_data; empty = skip) ----
# Admin login for http://localhost:5173/admin
DEMO_EMAIL=admin@vedamind.local
DEMO_PASSWORD=VedaMind@Admin123
# A ready-made user for demos
DEMO_USER_EMAIL=demo@vedamind.local
DEMO_USER_PASSWORD=VedaMind@Demo123
